# Racing Studio AI — copie para .env (o comando `npm run setup` faz isso por você).
# Somente placeholders aqui. Nunca coloque credenciais reais neste arquivo de exemplo.

# Endereço da API. Loopback por padrão (só este computador acessa).
API_HOST=127.0.0.1
API_PORT=4310

# Token local exigido em todas as chamadas da API (gerado pelo setup).
STUDIO_TOKEN=troque-por-um-token-aleatorio

# Nome que aparece nas aprovações.
STUDIO_USER=usuario-local

# Pasta de dados (banco SQLite, originais, proxies, renders e exportações).
DATA_DIR=./data

# Limites (RF-001 / seção 16 da spec).
MAX_IMPORT_MB=8192
MAX_IMPORT_DURATION_MIN=120
MIN_FREE_DISK_MB=2048
WORKER_CONCURRENCY=1

# Caminhos opcionais para FFmpeg/ffprobe (vazio = usar o PATH).
FFMPEG_PATH=
FFPROBE_PATH=

# Limiar de triagem de confiança (seção 9 da spec).
CONFIDENCE_TRIAGE_THRESHOLD=0.80

# Provedores de IA (M2). Ficam desabilitados até configuração explícita.
LLM_PROVIDER=
LLM_ENDPOINT=
VOICE_PROVIDER=
VISION_PROVIDER=
